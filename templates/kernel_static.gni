import("//build/boards/${board}.gni")
import("//build/config/artifact_profiles.gni")
import("//build/templates/rust.gni")

# Build a fixed-address static kernel image (ET_EXEC) and gate its ELF contract.
#
# The kernel is never relocated by the loader: it links the shared PIC sysroot
# once and lets the linker absorb the relative relocations at link time. This
# profile pins `-Crelocation-model=static` on top of the target spec's PIC
# default and forbids PT_INTERP / PT_DYNAMIC / DT_NEEDED / TEXTREL / runtime
# relocations (see `check_blueos_elf.py`).
#
# Produces two targets:
# :<name>        the linked `bin/<name>` (ET_EXEC)
# :<name>_check  runs the ELF contract gate (depends on :<name>)
template("kernel_static") {
  assert(defined(invoker.sources), "kernel_static requires `sources`")

  _name = target_name
  _target_profile = dynamic_profile_id
  if (defined(invoker.target_profile)) {
    _target_profile = invoker.target_profile
  }

  build_rust(_name) {
    forward_variables_from(invoker, "*", [ "rustflags" ])
    crate_type = "bin"
    rustflags = kernel_static_rustflags
    if (defined(invoker.rustflags)) {
      rustflags += invoker.rustflags
    }
  }

  _out_dir = get_label_info(":${_name}", "root_out_dir")
  _elf = "${_out_dir}/bin/${_name}"

  action("${_name}_check") {
    forward_variables_from(invoker, [ "testonly" ])
    script = "//build/scripts/check_blueos_elf.py"
    inputs = [ _elf ]
    deps = [ ":${_name}" ]
    args = [
      "--profile",
      "kernel_static",
      "--target-profile",
      _target_profile,
      "--stamp",
      rebase_path("${target_gen_dir}/${_name}_check.stamp"),
      rebase_path(_elf),
    ]
    outputs = [ "${target_gen_dir}/${_name}_check.stamp" ]
  }
}
