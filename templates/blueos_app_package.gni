import("//build/boards/${board}.gni")
import("//build/templates/blueos_dso.gni")
import("//build/templates/dynamic_app.gni")

# Build a manifest-closed dynamic application package (Phase 2, C30 §6).
#
# A package is a root dynamic application plus its private DSOs. Every image is
# built as a real dynamic artifact (the root through `dynamic_app`, each
# private DSO through `blueos_dso` with its SONAME), and the build then
# generates a read-only manifest from the *final ELFs* and validates it
# bidirectionally. The kernel consumes the manifest + the layout JSON at a
# later commit; nothing here guesses the closure from GN arguments.
#
# Invoker contract:
#   package_id          e.g. "multi"
#   profile             dynamic target profile id (recorded in the manifest)
#   system_sonames      reserved system SONAMEs (e.g. ["libc.so.1"])
#   root_path           the package VFS path of the root, e.g. "/apps/multi/app.elf"
#   root_sources        the root crate sources
#   root_depends        private DSO names the root needs (link-order hint only)
#   private_dsos        list of scopes: {
#                         name       GN target name / crate name
#                         soname     e.g. "libfoo.so.1"
#                         vfs_path   e.g. "/apps/multi/lib/libfoo.so.1"
#                         sources    crate sources
#                         depends    private DSO names it links against
#                       }
#   extra_root_deps     optional additional root deps (default [])
#
# Produces:
#   :<name>_root        the linked root PIE (bin/<name>_root)
#   :<name>_manifest    the generated manifest JSON + layout JSON
#   :<name>_check       the bidirectional package check
template("blueos_app_package") {
  assert(defined(invoker.package_id), "package_id required")
  assert(defined(invoker.profile), "profile required (§9.1: pass the board's dynamic_profile_id)")
  assert(defined(invoker.root_sources), "root_sources required")
  assert(defined(invoker.root_path), "root_path required")

  _name = target_name
  # §9.1: the *board* policy picks the dynamic target profile; each package
  # BUILD.gn forwards the board's dynamic_profile_id through the call block.
  _profile = invoker.profile
  _system_sonames = []
  if (defined(invoker.system_sonames)) {
    _system_sonames = invoker.system_sonames
  }
  _lib_dir = rebase_path("${root_out_dir}/lib")

  _private_dsos = []
  if (defined(invoker.private_dsos)) {
    _private_dsos = invoker.private_dsos
  }

  # --- private DSOs ---------------------------------------------------------
  # blueos_dso emits lib/lib<name>.so for each private DSO.
  if (defined(invoker.private_dsos)) {
    foreach(_dso, _private_dsos) {
      blueos_dso(_dso.name) {
        target_profile = _profile
        crate_name = _dso.name
        soname = _dso.soname
        sources = _dso.sources
        deps = [
          "//librs:libc",
        ]
        rustflags = [ "-Clink-arg=-L${_lib_dir}" ]
        rustflags += [ "-Clink-arg=-l:liblibrs.so" ]
        foreach(_dep, _dso.depends) {
          rustflags += [ "-Clink-arg=-l:lib${_dep}.so" ]
          deps += [ ":${_dep}" ]
        }
        if (defined(_dso.rustflags)) {
          rustflags += _dso.rustflags
        }
      }
    }
  }

  # --- root ------------------------------------------------------------
  dynamic_app("${_name}_root") {
    target_profile = _profile
    sources = invoker.root_sources
    start_object = "//librs:blueos_scrt1"
    deps = [
      "//librs:blueos_scrt1",
      "//librs:libc",
    ]
    foreach(_dso, _private_dsos) {
      deps += [ ":${_dso.name}" ]
    }
    if (defined(invoker.extra_root_deps)) {
      deps += invoker.extra_root_deps
    }
    rustflags = [
      "-Clinker=clang",
      "-Clink-arg=-fuse-ld=lld",
      "-Clink-arg=--target=${dynamic_link_target}",
      "-Clink-arg=-L${_lib_dir}",
      "-Clink-arg=-l:liblibrs.so",
      "-Clink-arg=-Wl,--export-dynamic-symbol=main",
    ]
    foreach(_option, dynamic_link_options) {
      rustflags += [ "-Clink-arg=${_option}" ]
    }
    foreach(_dep, invoker.root_depends) {
      rustflags += [ "-Clink-arg=-l:lib${_dep}.so" ]
    }
    if (defined(invoker.root_rustflags)) {
      rustflags += invoker.root_rustflags
    }
  }

  # --- manifest generation --------------------------------------------------
  _root_elf = "${root_out_dir}/bin/${_name}_root"
  _manifest = "${target_gen_dir}/${_name}_manifest.json"
  _layout = "${target_gen_dir}/${_name}_layout.json"

  _manifest_args = [
    "--package-id",
    invoker.package_id,
    "--profile",
    _profile,
    "--root",
    invoker.root_path + "," + rebase_path(_root_elf),
    "--out",
    rebase_path(_manifest),
    "--layout",
    rebase_path(_layout),
  ]
  foreach(_soname, _system_sonames) {
    _manifest_args += [ "--system-soname", _soname ]
  }
  foreach(_dso, _private_dsos) {
    _manifest_args += [
      "--private",
      _dso.soname + "," + _dso.vfs_path + "," +
      rebase_path("${root_out_dir}/lib/lib${_dso.name}.so"),
    ]
  }

  action("${_name}_manifest") {
    script = "//build/scripts/gen_blueos_app_manifest.py"
    deps = [ ":${_name}_root" ]
    deps += [ ":${_name}_root_check" ]
    foreach(_dso, _private_dsos) {
      deps += [ ":${_dso.name}" ]
      deps += [ ":${_dso.name}_check" ]
    }
    inputs = [ _root_elf ]
    foreach(_dso, _private_dsos) {
      inputs += [ "${root_out_dir}/lib/lib${_dso.name}.so" ]
    }
    args = _manifest_args
    outputs = [
      _manifest,
      _layout,
    ]
  }

  # --- bidirectional check --------------------------------------------------
  _check_args = [
    "--manifest",
    rebase_path(_manifest),
    "--root",
    rebase_path(_root_elf),
  ]
  foreach(_dso, _private_dsos) {
    _check_args += [
      "--private",
      _dso.soname + "," + rebase_path("${root_out_dir}/lib/lib${_dso.name}.so"),
    ]
  }

  action("${_name}_check") {
    script = "//build/scripts/check_blueos_app_package.py"
    deps = [
      ":${_name}_manifest",
      ":${_name}_root",
    ]
    foreach(_dso, _private_dsos) {
      deps += [ ":${_dso.name}" ]
    }
    inputs = [
      _manifest,
      _root_elf,
    ]
    foreach(_dso, _private_dsos) {
      inputs += [ "${root_out_dir}/lib/lib${_dso.name}.so" ]
    }
    args = _check_args
    outputs = [ "${target_gen_dir}/${_name}_check.stamp" ]
  }

  group(_name) {
    deps = [ ":${_name}_check" ]
  }
}
