import("//build/boards/${board}.gni")

# Build one freestanding C/C++ dynamic artifact with Clang and LLD, then run
# the same ELF contract gate used by Rust dynamic applications and DSOs.
#
# Required invoker variables:
#   kind       "pie" or "dso"
#   output     output ELF path under the build directory
#   sources    C/C++ source files
#   libraries  already-built DSO paths passed directly to LLD
#   deps       GN targets producing libraries/start_object
#
# PIE additionally requires start_object; DSO additionally requires soname.
template("blueos_clang_dynamic_artifact") {
  assert(
      defined(invoker.kind) && (invoker.kind == "pie" || invoker.kind == "dso"),
      "kind must be `pie` or `dso`")
  assert(defined(invoker.output), "output is required")
  assert(defined(invoker.sources) && invoker.sources != [],
         "sources are required")
  assert(defined(invoker.libraries), "libraries are required")
  assert(defined(invoker.deps), "deps are required")
  assert(invoker.kind != "pie" || defined(invoker.start_object),
         "PIE requires start_object")
  assert(invoker.kind != "dso" || defined(invoker.soname),
         "DSO requires soname")

  _name = target_name
  _kind = invoker.kind
  _output = invoker.output
  _sources = invoker.sources
  _libraries = invoker.libraries
  _deps = invoker.deps
  if (_kind == "pie") {
    _start_object = invoker.start_object
  } else {
    _soname = invoker.soname
  }
  _target_profile = dynamic_profile_id
  if (defined(invoker.target_profile)) {
    _target_profile = invoker.target_profile
  }

  action(_name) {
    script = "//build/scripts/build_blueos_clang_dynamic.py"
    sources = _sources
    inputs = _libraries
    deps = _deps
    if (_kind == "pie") {
      inputs += [ _start_object ]
    }
    args = [
      "--kind",
      _kind,
      "--target",
      dynamic_link_target,
      "--output",
      rebase_path(_output, root_build_dir),
    ]
    foreach(_source, _sources) {
      args += [
        "--source",
        rebase_path(_source, root_build_dir),
      ]
    }
    foreach(_library, _libraries) {
      args += [
        "--library",
        rebase_path(_library, root_build_dir),
      ]
    }
    if (_kind == "pie") {
      args += [
        "--start-object",
        rebase_path(_start_object, root_build_dir),
      ]
    } else {
      args += [
        "--soname",
        _soname,
      ]
    }
    outputs = [ _output ]
  }

  _profile = "dynamic_app"
  if (_kind == "dso") {
    _profile = "dso"
  }
  action("${_name}_check") {
    script = "//build/scripts/check_blueos_elf.py"
    inputs = [ _output ]
    deps = [ ":${_name}" ]
    args = [
      "--profile",
      _profile,
      "--target-profile",
      _target_profile,
      "--stamp",
      rebase_path("${target_gen_dir}/${_name}_check.stamp", root_build_dir),
      rebase_path(_output, root_build_dir),
    ]
    outputs = [ "${target_gen_dir}/${_name}_check.stamp" ]
  }
}
