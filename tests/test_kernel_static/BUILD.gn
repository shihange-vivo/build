import("//build/templates/kernel_static.gni")

# Standalone smoke test for the kernel_static profile. It mirrors the board
# kernel_config link setup: the kernel links through `arm-none-eabi-gcc`
# (not the target spec's default rust-lld), because the `rust_bin` tool
# injects `-Wl,-Map=...` which only a cc driver understands.
kernel_static("kernel_static_demo") {
  sources = [ "src/main.rs" ]
  rustflags = [
    "-Clinker=arm-none-eabi-gcc",
    "-Clink-arg=-nostartfiles",
  ]
}
